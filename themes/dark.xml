<!-- lightview's Dark theme. lightview writes dark.xml, light.xml and high-contrast.xml into its
     themes folder the first time it starts; edit them, or copy one under a new name to make your own.
     mode is "dark" or "light". Colours are #rrggbb or #rrggbbaa. A key left out takes the built-in
     base theme's value (the original Light theme). Every key is described in docs/FEATURES.md (Themes). -->
<theme mode="dark">
  <colors panel="#1b1b1b" window="#1b1b1b" border="#3c3c3c" field="#0a0a0a" text="#8c8c8c"
          accent="#005c80" selected-text="#c0deff" hyperlink="#5aaaff" warn="#ff8f00" error="#ff0000"/>
  <widget state="noninteractive" fill="#1b1b1b" text="#8c8c8c" border="#3c3c3c"/>
  <widget state="inactive" fill="#323232" text="#d7d7d7" border="#323232"/>
  <widget state="hovered" fill="#404040" text="#f5f5f5" border="#969696"/>
  <widget state="active" fill="#282828" text="#ffffff" border="#ffffff"/>
  <widget state="open" fill="#2d2d2d" text="#d2d2d2" border="#3c3c3c"/>
  <canvas outline="#ffffff" handle="#42a5f5" guide="#ffff00"/>
  <shape rounding="6" stroke="1" spacing="8,3" padding="4,1"/>
</theme>
